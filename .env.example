# ─────────────────────────────────────────────
#  PHAKTS·STUDIO — Configuration API
#  Copiez ce fichier en ".env" et remplissez les valeurs
# ─────────────────────────────────────────────

# Fournisseur du LLM de codification : "anthropic" (Claude, payant) ou
# "gemini" (Google, gratuit). Si omis, détecté automatiquement : "gemini" si
# GEMINI_API_KEY est renseignée, sinon "anthropic".
LLM_PROVIDER=gemini

# Clé API Google Gemini (gratuite) — nécessaire si LLM_PROVIDER=gemini.
# Obtenez-la en ~2 min, sans carte bancaire : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=VOTRE_CLE_GEMINI_ICI

# Modèle Gemini utilisé (optionnel, défaut: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Clé API Anthropic (nécessaire uniquement si LLM_PROVIDER=anthropic)
# Obtenez-la sur https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-VOTRE_CLE_ICI

# Port du serveur (optionnel, défaut: 3000)
PORT=3000

# Hôte d'écoute du serveur.
# Utilisez 127.0.0.1 (défaut) pour écouter localement seulement.
# Utilisez 0.0.0.0 pour rendre l'API accessible depuis d'autres ordinateurs du même réseau.
HOST=127.0.0.1

# Origines autorisées pour CORS (séparées par des virgules)
# Ne PAS utiliser * en production
ALLOWED_ORIGINS=http://localhost:3000

# Token d'authentification pour protéger les endpoints API (fortement recommandé)
# Générez un token sécurisé : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# Environnement : development | production
NODE_ENV=development

# Nombre max de requêtes par fenêtre de 15 minutes
RATE_LIMIT_MAX=50
